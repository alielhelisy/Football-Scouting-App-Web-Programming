@{ ViewData["Title"] = "Change Password"; Layout = "_Layout"; }

@section Styles {
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --nav-bg: #0f1117;
    --nav-border: #1e2230;
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(62% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --btn-delete: oklch(58% 0.2 25);
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  main.change-password-page {
    flex: 1;
    padding: 40px 24px;
    max-width: 560px;
    margin: 0 auto;
    width: 100%;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
    transition: color 0.18s ease;
  }
  .back-link:hover { color: var(--text); }

  .page-head { margin-bottom: 24px; }

  .page-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: 0.03em;
    line-height: 1.1;
  }

  .page-sub {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .security-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px 32px;
    position: relative;
    overflow: hidden;
  }

  .security-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-orange), var(--accent-blue));
  }

  .pw-form { display: block; }

  .pw-field { margin-bottom: 18px; }

  .pw-label {
    display: block;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 7px;
  }

  .pw-input-wrap { position: relative; }

  .pw-input {
    width: 100%;
    font-family: 'Barlow', sans-serif;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 11px 44px 11px 14px;
    transition: border-color 0.18s ease;
  }
  .pw-input::placeholder { color: var(--text-muted); }
  .pw-input:focus { outline: none; border-color: var(--accent-blue); }
  .pw-input.error { border-color: var(--btn-delete); }

  .pw-eye {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.18s ease;
  }
  .pw-eye:hover { color: var(--text-dim); }

  .pw-hint {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .pw-hint.error { color: oklch(72% 0.2 25); }

  .pw-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .btn-save-pw {
    font-family: 'Barlow', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    padding: 11px 22px;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    background: var(--accent-blue);
    color: #fff;
    letter-spacing: 0.02em;
    transition: all 0.18s ease;
  }
  .btn-save-pw:hover { filter: brightness(1.12); transform: translateY(-1px); }

  .btn-cancel-pw {
    font-family: 'Barlow', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    padding: 11px 22px;
    border-radius: 7px;
    cursor: pointer;
    background: none;
    color: var(--text-muted);
    border: 1px solid var(--border);
    letter-spacing: 0.02em;
    transition: all 0.18s ease;
    text-decoration: none;
    display: inline-block;
  }
  .btn-cancel-pw:hover { color: var(--text); border-color: var(--text-muted); }
</style>
}

<main class="change-password-page">
  <a class="back-link" asp-controller="Auth" asp-action="Account">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
    Back to Account
  </a>

  <div class="page-head">
    <div class="page-title">Change Password</div>
    <div class="page-sub">Keep your account secure with a strong password.</div>
  </div>

  <div class="security-card">
    <form class="pw-form" id="pwForm" asp-controller="Auth" asp-action="ChangePassword" method="post" autocomplete="off" onsubmit="return validatePwForm(event)">
      @Html.AntiForgeryToken()

      <div class="pw-field">
        <label class="pw-label" for="currentPw">Current Password</label>
        <div class="pw-input-wrap">
          <input class="pw-input" type="password" id="currentPw" name="currentPassword" placeholder="Enter current password" autocomplete="current-password" required autofocus>
          <button type="button" class="pw-eye" onclick="toggleEye('currentPw', this)" aria-label="Show password">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="pw-field">
        <label class="pw-label" for="newPw">New Password</label>
        <div class="pw-input-wrap">
          <input class="pw-input" type="password" id="newPw" name="newPassword" placeholder="Enter new password" autocomplete="new-password" required oninput="checkMatch()">
          <button type="button" class="pw-eye" onclick="toggleEye('newPw', this)" aria-label="Show password">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <div class="pw-hint" id="newPwHint">Use at least 6 characters.</div>
      </div>

      <div class="pw-field">
        <label class="pw-label" for="confirmPw">Confirm New Password</label>
        <div class="pw-input-wrap">
          <input class="pw-input" type="password" id="confirmPw" name="confirmPassword" placeholder="Re-enter new password" autocomplete="new-password" required oninput="checkMatch()">
          <button type="button" class="pw-eye" onclick="toggleEye('confirmPw', this)" aria-label="Show password">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <div class="pw-hint" id="confirmPwHint"></div>
      </div>

      <div class="pw-actions">
        <button type="submit" class="btn-save-pw">Update Password</button>
        <a class="btn-cancel-pw" asp-controller="Auth" asp-action="Account">Cancel</a>
      </div>
    </form>
  </div>
</main>

@section Scripts {
<script>
  function toggleEye(id, btn) {
    const input = document.getElementById(id);
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.innerHTML = show
      ? '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19M1 1l22 22M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>'
      : '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>';
  }

  function checkMatch() {
    const newPw = document.getElementById('newPw').value;
    const confirmPw = document.getElementById('confirmPw').value;
    const confirmHint = document.getElementById('confirmPwHint');
    const confirmInput = document.getElementById('confirmPw');

    if (!confirmPw) {
      confirmHint.textContent = '';
      confirmHint.classList.remove('error');
      confirmInput.classList.remove('error');
      return;
    }

    if (newPw !== confirmPw) {
      confirmHint.textContent = 'Passwords do not match.';
      confirmHint.classList.add('error');
      confirmInput.classList.add('error');
    } else {
      confirmHint.textContent = 'Passwords match.';
      confirmHint.classList.remove('error');
      confirmInput.classList.remove('error');
    }
  }

  function validatePwForm(e) {
    const current = document.getElementById('currentPw');
    const newPw = document.getElementById('newPw');
    const confirmPw = document.getElementById('confirmPw');
    const newHint = document.getElementById('newPwHint');
    const confirmHint = document.getElementById('confirmPwHint');
    let ok = true;

    [current, newPw, confirmPw].forEach(i => i.classList.remove('error'));
    newHint.classList.remove('error');
    newHint.textContent = 'Use at least 6 characters.';
    confirmHint.classList.remove('error');

    if (!current.value) { current.classList.add('error'); ok = false; }
    if (newPw.value.length < 6) {
      newPw.classList.add('error');
      newHint.textContent = 'Password must be at least 6 characters.';
      newHint.classList.add('error');
      ok = false;
    }
    if (newPw.value !== confirmPw.value) {
      confirmPw.classList.add('error');
      confirmHint.textContent = 'Passwords do not match.';
      confirmHint.classList.add('error');
      ok = false;
    }

    if (!ok) {
      e.preventDefault();
      return false;
    }

    return true;
  }
</script>
}
