@{ ViewData["Title"] = "Sign In"; Layout = "_Layout"; }

@section Styles {
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(56% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --input-bg: #1c2232;
    --input-border: #2a3245;
    --input-focus: oklch(56% 0.18 210);
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 30%, #1a2a1c 0%, #0f1117 65%);
  }

  /* ── CARD ── */
  .signin-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04),
      0 32px 80px rgba(0,0,0,0.6),
      0 0 60px rgba(45,106,53,0.15);
  }

  /* ── HEADER ── */
  .signin-header {
    padding: 28px 32px 24px;
    background: linear-gradient(135deg, rgba(45,106,53,0.25) 0%, rgba(45,106,53,0.08) 60%, transparent 100%);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .signin-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-blue));
    border-radius: 20px 20px 0 0;
  }

  .signin-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .signin-logo-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: var(--accent);
    display: flex; align-items: center; justify-content: center;
    opacity: 0.9;
  }

  .signin-logo-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px; font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .signin-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 32px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* ── BODY ── */
  .signin-body {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }

  .field-label {
    font-size: 11px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .input-wrap { position: relative; }

  input[type="text"],
  input[type="password"],
  input[type="email"] {
    font-family: 'Barlow', sans-serif;
    font-size: 14.5px; font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 9px;
    padding: 11px 14px;
    width: 100%;
    outline: none;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  input:focus {
    border-color: var(--input-focus);
    box-shadow: 0 0 0 3px oklch(56% 0.18 210 / 0.15);
  }

  input::placeholder { color: #374151; }

  /* password toggle */
  .input-wrap input[type="password"],
  .input-wrap input[type="text"] {
    padding-right: 42px;
  }

  .toggle-pw {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none; border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
    display: flex; align-items: center;
    transition: color 0.15s;
  }
  .toggle-pw:hover { color: var(--text); }

  /* show password checkbox */
  .show-pw-row {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }

  .show-pw-row input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .custom-check {
    width: 16px; height: 16px;
    border-radius: 5px;
    border: 1.5px solid var(--input-border);
    background: var(--input-bg);
    display: flex; align-items: center; justify-content: center;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .custom-check svg {
    opacity: 0;
    transition: opacity 0.15s;
  }

  .show-pw-row.checked .custom-check {
    background: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .show-pw-row.checked .custom-check svg {
    opacity: 1;
  }

  .show-pw-label {
    font-size: 13px; font-weight: 500;
    color: var(--text-dim);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .show-pw-row:hover .show-pw-label { color: var(--text); }

  /* divider */
  .divider {
    height: 1px;
    background: var(--border);
    margin: 2px 0;
  }

  /* ── FOOTER ── */
  .signin-footer {
    padding: 0 32px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .link-create {
    font-size: 13px; font-weight: 600;
    color: var(--accent-blue);
    cursor: pointer;
    background: none; border: none;
    transition: color 0.15s, text-decoration 0.15s;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .link-create:hover {
    color: oklch(68% 0.18 210);
    text-decoration: none;
  }

  .footer-btns { display: flex; align-items: center; gap: 8px; }

  .btn-cancel {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 600;
    padding: 10px 20px; border-radius: 9px;
    border: 1px solid var(--border);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn-cancel:hover { background: var(--surface2); color: var(--text); border-color: #3a4460; }

  .btn-login {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 700;
    padding: 10px 28px; border-radius: 9px;
    border: none;
    background: var(--accent-blue); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }
  .btn-login:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px oklch(56% 0.18 210 / 0.4);
  }
  .btn-login:active { transform: translateY(0); }

</style>
}

<div class="signin-card">
  <div class="signin-header">
    <div class="signin-logo">
      <div class="signin-logo-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
        </svg>
      </div>
      <span class="signin-logo-text">Scouting App</span>
    </div>
    <div class="signin-title">Sign In</div>
  </div>

  <form asp-controller="Auth" asp-action="Login" method="post">
    <div class="signin-body">
      <div class="field">
        <label class="field-label">Username or Email</label>
        <div class="input-wrap">
          <input type="text" name="username" id="username" placeholder="Enter your username or email" required>
        </div>
      </div>
      <div class="field">
        <label class="field-label">Password</label>
        <div class="input-wrap">
          <input type="password" name="password" id="password" placeholder="Enter your password" required>
          <button class="toggle-pw" onclick="togglePassword(event)" type="button">
            <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
      <label class="show-pw-row" id="show-pw-label">
        <input type="checkbox" id="show-password" onchange="setPasswordVisible(this.checked)">
        <div class="custom-check">
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,5 4,7 8,3"/></svg>
        </div>
        <span class="show-pw-label">Show Password</span>
      </label>
      <div class="divider"></div>
    </div>
    <div class="signin-footer">
      <a class="link-create" asp-controller="Auth" asp-action="Register">Create Account</a>
      <div class="footer-btns">
        <button type="button" class="btn-cancel" onclick="document.getElementById('username').value='';document.getElementById('password').value=''">Cancel</button>
        <button type="submit" class="btn-login">Login</button>
      </div>
    </div>
  </form>
</div>

@section Scripts {
<script>
    function setPasswordVisible(visible) {
    const pw = document.getElementById('password');
    const icon = document.getElementById('eye-icon');
    const checkbox = document.getElementById('show-password');
    const label = document.getElementById('show-pw-label');

    pw.type = visible ? 'text' : 'password';
    checkbox.checked = visible;
    label.classList.toggle('checked', visible);
    icon.innerHTML = visible
      ? '<line x1="1" y1="1" x2="23" y2="23"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }

  function togglePassword(e) {
    e.preventDefault();
    const pw = document.getElementById('password');
    setPasswordVisible(pw.type === 'password');
  }

</script>
}



