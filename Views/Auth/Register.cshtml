@{ ViewData["Title"] = "Create Account"; Layout = "_Layout"; }

@section Styles {
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(56% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --input-bg: #1c2232;
    --input-border: #2a3245;
    --input-focus: oklch(56% 0.18 210);
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: radial-gradient(ellipse at 50% 30%, #1a2a1c 0%, #0f1117 65%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }

  /*  CARD  */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04),
      0 32px 80px rgba(0,0,0,0.6),
      0 0 60px rgba(45,106,53,0.12);
  }

  /*  HEADER  */
  .card-header {
    padding: 26px 32px 22px;
    background: linear-gradient(135deg, rgba(45,106,53,0.22) 0%, rgba(45,106,53,0.06) 60%, transparent 100%);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .card-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-blue));
    border-radius: 20px 20px 0 0;
  }

  .card-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .card-logo-icon {
    width: 32px; height: 32px;
    border-radius: 9px;
    background: var(--accent);
    display: flex; align-items: center; justify-content: center;
    opacity: 0.9;
  }

  .card-logo-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px; font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 30px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  /*  BODY  */
  .card-body {
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* two column row */
  .fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }

  .field-label {
    font-size: 10.5px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .input-wrap { position: relative; }

  input[type="text"],
  input[type="email"],
  input[type="password"] {
    font-family: 'Barlow', sans-serif;
    font-size: 14px; font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 9px;
    padding: 10px 14px;
    width: 100%;
    outline: none;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  input:focus {
    border-color: var(--input-focus);
    box-shadow: 0 0 0 3px oklch(56% 0.18 210 / 0.15);
  }

  input::placeholder { color: #374151; }

  /* password eye toggle */
  .input-wrap input { padding-right: 42px; }
  .toggle-pw {
    position: absolute;
    right: 12px; top: 50%;
    transform: translateY(-50%);
    background: none; border: none;
    cursor: pointer; color: var(--text-muted);
    display: flex; align-items: center;
    transition: color 0.15s; padding: 4px;
  }
  .toggle-pw:hover { color: var(--text); }

  /* password strength bar */
  .strength-bar {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
    margin-top: 6px;
    overflow: hidden;
  }
  .strength-fill {
    height: 100%;
    border-radius: 2px;
    width: 0%;
    transition: width 0.3s ease, background 0.3s ease;
    background: oklch(58% 0.2 25);
  }

  /* divider */
  .divider { height: 1px; background: var(--border); margin: 4px 0; }

  /*  FOOTER  */
  .card-footer {
    padding: 0 32px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .link-back {
    font-size: 13px; font-weight: 600;
    color: var(--accent-blue);
    cursor: pointer; background: none; border: none;
    transition: color 0.15s; text-decoration: none;
    white-space: nowrap;
  }
  .link-back:hover { color: oklch(68% 0.18 210); text-decoration: none; }

  .footer-btns { display: flex; align-items: center; gap: 8px; }

  .btn-cancel {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 600;
    padding: 10px 20px; border-radius: 9px;
    border: 1px solid var(--border);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn-cancel:hover { background: var(--surface2); color: var(--text); border-color: #3a4460; }

  .btn-create {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 700;
    padding: 10px 26px; border-radius: 9px;
    border: none;
    background: var(--accent-blue); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; letter-spacing: 0.03em;
  }
  .btn-create:hover {
    filter: brightness(1.12); transform: translateY(-1px);
    box-shadow: 0 4px 14px oklch(56% 0.18 210 / 0.4);
  }
  .btn-create:active { transform: translateY(0); }
</style>
}

<div class="card">
  <div class="card-header">
    <div class="card-logo">
      <div class="card-logo-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
        </svg>
      </div>
      <span class="card-logo-text">Scouting App</span>
    </div>
    <div class="card-title">Create Account</div>
  </div>
  <form asp-controller="Auth" asp-action="Register" method="post">
    <div class="card-body">
      <div class="field">
        <label class="field-label">Username</label>
        <div class="input-wrap">
          <input type="text" name="username" id="username" placeholder="Choose a username" required>
        </div>
      </div>
      <div class="fields-row">
        <div class="field">
          <label class="field-label">First Name</label>
          <div class="input-wrap">
            <input type="text" name="name" placeholder="First name" required>
          </div>
        </div>
        <div class="field">
          <label class="field-label">Last Name</label>
          <div class="input-wrap">
            <input type="text" name="surname" placeholder="Last name" required>
          </div>
        </div>
      </div>
      <div class="field">
        <label class="field-label">Email</label>
        <div class="input-wrap">
          <input type="email" name="email" placeholder="your@email.com" required>
        </div>
      </div>
      <div class="field">
        <label class="field-label">Password</label>
        <div class="input-wrap">
          <input type="password" name="password" id="password" placeholder="Create a password" required oninput="checkStrength(this.value)">
          <button class="toggle-pw" type="button" onclick="togglePw('password', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <div class="strength-bar"><div class="strength-fill" id="strength-fill"></div></div>
      </div>
      <div class="field">
        <label class="field-label">Confirm Password</label>
        <div class="input-wrap">
          <input type="password" name="confirmPassword" id="confirm-password" placeholder="Repeat your password" required>
          <button class="toggle-pw" type="button" onclick="togglePw('confirm-password', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="divider"></div>
    </div>
    <div class="card-footer">
      <a class="link-back" asp-controller="Auth" asp-action="Login">Back to Login</a>
      <div class="footer-btns">
        <a class="btn-cancel" asp-controller="Auth" asp-action="Login">Cancel</a>
        <button type="submit" class="btn-create">Create</button>
      </div>
    </div>
  </form>
</div>


@section Scripts {
<script>
  function togglePw(id, btn) {
    const input = document.getElementById(id);
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.querySelector('svg').innerHTML = isHidden
      ? '<line x1="1" y1="1" x2="23" y2="23"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }

  function checkStrength(val) {
    const fill = document.getElementById('strength-fill');
    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const widths = ['0%', '25%', '50%', '75%', '100%'];
    const colors = ['oklch(58% 0.2 25)', 'oklch(58% 0.2 25)', 'oklch(72% 0.19 40)', 'oklch(62% 0.18 145)', 'oklch(62% 0.18 145)'];
    fill.style.width = widths[score];
    fill.style.background = colors[score];
  }
</script>
}


