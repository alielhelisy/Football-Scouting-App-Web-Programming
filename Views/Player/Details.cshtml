@model ScoutingAppMvc.Models.Player
@{
    ViewData["Title"] = Model.Name;
    var reports    = (List<ScoutingAppMvc.Models.Report>)ViewBag.Reports;
    var positions  = (Dictionary<string,string>)ViewBag.Positions;
    string posDisp = ViewBag.PosDisplay;
    bool   isAdmin = ViewBag.IsAdmin;
}

@section Styles {
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(56% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  /* ── NAVBAR ── */
  nav {
    background: #0f1117;
    border-bottom: 1px solid #1e2230;
    padding: 0 28px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-left { display: flex; align-items: center; gap: 10px; }
  .nav-username { font-weight: 700; font-size: 15px; color: var(--accent-orange); letter-spacing: 0.02em; }
  .nav-badge {
    background: oklch(58% 0.2 25); color: #fff;
    font-size: 10px; font-weight: 700; padding: 3px 8px;
    border-radius: 4px; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .nav-right { display: flex; align-items: center; gap: 6px; }
  .nav-link {
    color: #9ca3af; font-size: 13.5px; font-weight: 500;
    padding: 6px 12px; border-radius: 6px; cursor: pointer;
    transition: color 0.2s, background 0.2s;
    text-decoration: none; background: none; border: none;
  }
  .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-btn {
    font-family: 'Barlow', sans-serif; font-size: 12.5px; font-weight: 600;
    padding: 7px 14px; border-radius: 7px; border: none; cursor: pointer;
    letter-spacing: 0.02em; transition: all 0.18s ease; white-space: nowrap;
  }
  .btn-create-nav { background: var(--accent-orange); color: #fff; }
  .btn-create-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-search-nav { background: var(--accent-blue); color: #fff; }
  .btn-search-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-accounts-nav { background: var(--accent); color: #fff; }
  .btn-accounts-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-delete-nav { background: oklch(58% 0.2 25); color: #fff; }
  .btn-delete-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-logout-nav { background: #374151; color: #e5e7eb; }
  .btn-logout-nav:hover { background: #4b5563; transform: translateY(-1px); }

  /* ── MAIN ── */
  main {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 36px 24px;
    background: radial-gradient(ellipse at 50% 0%, #1a1f2e 0%, #0f1117 65%);
  }

  .page-wrap {
    width: 100%;
    max-width: 1230px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ── PLAYER HEADER CARD ── */
  .player-header-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px 26px;
    position: relative;
    overflow: hidden;
  }

  .player-header-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent));
    border-radius: 16px 16px 0 0;
  }

  .player-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .player-left { display: flex; flex-direction: column; gap: 10px; }

  .player-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 30px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .player-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pos-tag {
    font-size: 11px; font-weight: 800;
    padding: 4px 10px; border-radius: 6px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pos-tag.def { background: oklch(56% 0.18 210 / 0.18); color: oklch(70% 0.16 210); border: 1px solid oklch(56% 0.18 210 / 0.35); }
  .pos-tag.mid { background: oklch(62% 0.18 145 / 0.15); color: oklch(72% 0.16 145); border: 1px solid oklch(62% 0.18 145 / 0.3); }

  .club-tag {
    display: flex; align-items: center; gap: 5px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px; font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .scout-tag {
    display: flex; align-items: center; gap: 5px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px; font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .player-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .btn-edit-player {
    font-family: 'Barlow', sans-serif;
    font-size: 12.5px; font-weight: 700;
    padding: 8px 16px; border-radius: 8px;
    border: none;
    background: var(--accent-blue); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; display: flex; align-items: center; gap: 6px;
  }
  .btn-edit-player:hover { filter: brightness(1.12); transform: translateY(-1px); }

  .btn-delete-player {
    font-family: 'Barlow', sans-serif;
    font-size: 12.5px; font-weight: 700;
    padding: 8px 16px; border-radius: 8px;
    border: none;
    background: oklch(58% 0.2 25); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; display: flex; align-items: center; gap: 6px;
  }
  .btn-delete-player:hover { filter: brightness(1.12); transform: translateY(-1px); }

  .btn-back-player {
    font-family: 'Barlow', sans-serif;
    font-size: 12.5px; font-weight: 600;
    padding: 8px 16px; border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; display: flex; align-items: center; gap: 6px;
  }
  .btn-back-player:hover { background: var(--surface2); color: var(--text); }

  /* ── PROFILE SECTION ── */
  .profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .profile-card-header {
    padding: 12px 22px;
    background: #111622;
    border-bottom: 1px solid var(--border);
  }

  .profile-card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .profile-grid {
    padding: 22px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 28px;
  }

  .profile-field {}

  .profile-field-label {
    font-size: 9.5px; font-weight: 800;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 4px;
  }

  .profile-field-value {
    font-size: 14.5px; font-weight: 600;
    color: var(--text);
  }

  .profile-field-value.empty {
    color: var(--text-muted);
    font-style: italic;
    font-weight: 400;
  }

  /* ── REPORTS CARD ── */
  .reports-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
  }

  .reports-header {
    min-height: 80px;
    padding: 18px 32px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
  }

  .reports-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .reports-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 19px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    min-width: max-content;
  }

  .reports-count {
    font-size: 13px; font-weight: 700;
    color: var(--text-muted);
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 5px 12px;
  }

  .btn-create-report {
    font-family: 'Barlow', sans-serif;
    font-size: 15px; font-weight: 800;
    padding: 11px 20px; border-radius: 9px;
    border: none;
    background: var(--accent-orange); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; display: flex; align-items: center; gap: 9px;
    margin-left: auto;
  }
  .btn-create-report:hover { filter: brightness(1.12); transform: translateY(-1px); }

  .reports-body { padding: 30px 32px 36px; }

  .reports-table-wrap {
    overflow-x: auto;
  }

  .reports-table {
    width: 100%;
    min-width: 1040px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .reports-table th {
    color: #7d879b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: left;
    text-transform: uppercase;
    padding: 16px 18px 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .reports-table td {
    color: #aebbd0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.28;
    padding: 20px 18px 14px 0;
    vertical-align: top;
  }

  .reports-table .report-date {
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .reports-table .report-comments {
    max-width: 520px;
  }

  .report-actions-cell {
    width: 104px;
    padding-right: 0;
    text-align: right;
  }

  .report-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    align-items: center;
  }

  .report-delete-form {
    display: inline-flex;
  }

  .rr-edit,
  .rr-del {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 10px;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: filter 0.18s ease, transform 0.18s ease;
  }

  .rr-edit {
    background: var(--accent-blue);
  }

  .rr-del {
    background: oklch(62% 0.2 25);
  }

  .rr-edit:hover,
  .rr-del:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .empty-state {
    text-align: center;
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 13px; font-weight: 500;
  }

  .empty-state-icon {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--surface2);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 12px;
    opacity: 0.6;
  }

  .empty-state-text { color: var(--text-muted); }
  .empty-state-text span { color: var(--accent-orange); font-weight: 700; cursor: pointer; }
  .empty-state-text span:hover { text-decoration: none; }

</style>
}

<main>
  <div class="page-wrap">

    <!-- PLAYER HEADER -->
    <div class="player-header-card">
      <div class="player-top">
        <div class="player-left">
          <div class="player-name">@Model.Name</div>
          <div class="player-tags">
            <span class="pos-tag def">@posDisp</span>
            @if (!string.IsNullOrEmpty(Model.OtherPosition))
            {
              var otherDisp = positions.GetValueOrDefault(Model.OtherPosition, Model.OtherPosition);
              <span class="pos-tag mid">@otherDisp</span>
            }
            @if (!string.IsNullOrEmpty(Model.Team))
            {
              <span class="club-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                </svg>
                @Model.Team
              </span>
            }
            @if (Model.User != null)
            {
              <span class="club-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                @Model.User.Username
              </span>
            }
          </div>
        </div>
        <div class="player-actions">
          <a class="btn-edit-player" asp-controller="Player" asp-action="Edit" asp-route-id="@Model.Id">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Edit Player
          </a>
          <form asp-controller="Player" asp-action="Delete" method="post" style="display:inline;"
                onsubmit="return confirm('Delete this player and all their reports?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn-delete-player">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
              </svg>
              Delete Player
            </button>
          </form>
          <a class="btn-back-player" asp-controller="Player" asp-action="ByPosition" asp-route-posKey="@Model.Position">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back
          </a>
        </div>
      </div>
    </div>

    <!-- PROFILE CARD -->
    <div class="profile-card">
      <div class="profile-card-header"><div class="profile-card-title">Player Profile</div></div>
      <div class="profile-grid">
        <div>
          <div class="profile-field-label">Full Name</div>
          @{ string fullName = (Model.FirstName + " " + Model.LastName).Trim(); }
          <div class="profile-field-value @(string.IsNullOrEmpty(fullName) ? "empty" : "")">
            @(string.IsNullOrEmpty(fullName) ? "" : fullName)
          </div>
        </div>
        <div>
          <div class="profile-field-label">Gender</div>
          <div class="profile-field-value @(string.IsNullOrEmpty(Model.Gender) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Gender) ? "" : Model.Gender)</div>
        </div>
        <div>
          <div class="profile-field-label">Nationality</div>
          <div class="profile-field-value @(string.IsNullOrEmpty(Model.Nationality) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Nationality) ? "" : Model.Nationality)</div>
        </div>
        <div>
          <div class="profile-field-label">Birthday</div>
          <div class="profile-field-value @(Model.Birthday == null ? "empty" : "")">@(Model.Birthday?.ToString("yyyy-MM-dd") ?? "")</div>
        </div>
        <div>
          <div class="profile-field-label">Height</div>
          <div class="profile-field-value @(Model.Height == null ? "empty" : "")">@(Model.Height.HasValue ? Model.Height + " cm" : "")</div>
        </div>
        <div>
          <div class="profile-field-label">Preferred Foot</div>
          <div class="profile-field-value @(string.IsNullOrEmpty(Model.Foot) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Foot) ? "" : Model.Foot)</div>
        </div>
        <div>
          <div class="profile-field-label">Weight</div>
          <div class="profile-field-value @(Model.Weight == null ? "empty" : "")">@(Model.Weight.HasValue ? Model.Weight + " kg" : "")</div>
        </div>
        <div>
          <div class="profile-field-label">Club</div>
          <div class="profile-field-value @(string.IsNullOrEmpty(Model.Team) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Team) ? "" : Model.Team)</div>
        </div>
      </div>
    </div>

    <!-- REPORTS -->
    <div class="reports-card">
      <div class="reports-header">
        <div class="reports-title">Report History</div>
        <span class="reports-count">@reports.Count report@(reports.Count != 1 ? "s" : "")</span>
        <a class="btn-create-report" asp-controller="Report" asp-action="Create" asp-route-playerId="@Model.Id">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Create Report
        </a>
      </div>
      <div class="reports-body">
        @if (!reports.Any())
        {
          <div class="empty-state">
            <div class="empty-state-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            </div>
            No reports yet. Use <strong style="color:var(--accent-orange)">Create Report</strong> to add one.
          </div>
        }
        else
        {
          <div class="reports-table-wrap">
            <table class="reports-table">
              <thead>
                <tr>
                  <th style="width: 125px;">Date</th>
                  <th style="width: 95px;">Rating</th>
                  <th style="width: 105px;">Minutes</th>
                  <th style="width: 90px;">Goals</th>
                  <th style="width: 95px;">Cards</th>
                  <th style="width: 110px;">Position</th>
                  <th>Comments</th>
                  <th class="report-actions-cell"></th>
                </tr>
              </thead>
              <tbody>
                @foreach (var r in reports)
                {
                  var ratedPosition = string.IsNullOrWhiteSpace(r.RatedPosition)
                    ? ""
                    : positions.GetValueOrDefault(r.RatedPosition, r.RatedPosition);
                  <tr>
                    <td class="report-date">@r.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@r.Rating.ToString("0.#")</td>
                    <td>@r.MinutesPlayed'</td>
                    <td>@r.GoalsScored</td>
                    <td>@r.ReceivedCards</td>
                    <td>@ratedPosition</td>
                    <td class="report-comments">@r.Comments</td>
                    <td class="report-actions-cell">
                      <div class="report-actions">
                        <a class="rr-edit" asp-controller="Report" asp-action="Edit" asp-route-id="@r.Id" aria-label="Edit report">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                          </svg>
                        </a>
                        <form class="report-delete-form" asp-controller="Report" asp-action="DeleteReport" method="post"
                              onsubmit="return confirm('Delete this report?')">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="playerId" value="@Model.Id" />
                          <input type="hidden" name="reportId" value="@r.Id" />
                          <button type="submit" class="rr-del" aria-label="Delete report">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>

  </div>
</main>



