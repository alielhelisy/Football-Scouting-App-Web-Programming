@model ScoutingAppMvc.Models.Report
@{
    ViewData["Title"] = "Edit Comment";
    var player   = (ScoutingAppMvc.Models.Player)ViewBag.Player;
    string posDisp = ViewBag.PosDisplay;
}

@section Styles {
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(56% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --input-bg: #1c2232;
    --input-border: #2a3245;
    --input-focus: oklch(56% 0.18 210);
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  /* ── NAVBAR ── */
  nav {
    background: #0f1117;
    border-bottom: 1px solid #1e2230;
    padding: 0 28px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-left { display: flex; align-items: center; gap: 10px; }
  .nav-username { font-weight: 700; font-size: 15px; color: var(--accent-orange); letter-spacing: 0.02em; }
  .nav-badge {
    background: oklch(58% 0.2 25); color: #fff;
    font-size: 10px; font-weight: 700; padding: 3px 8px;
    border-radius: 4px; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .nav-right { display: flex; align-items: center; gap: 6px; }
  .nav-link {
    color: #9ca3af; font-size: 13.5px; font-weight: 500;
    padding: 6px 12px; border-radius: 6px; cursor: pointer;
    transition: color 0.2s, background 0.2s;
    text-decoration: none; background: none; border: none;
  }
  .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-btn {
    font-family: 'Barlow', sans-serif; font-size: 12.5px; font-weight: 600;
    padding: 7px 14px; border-radius: 7px; border: none; cursor: pointer;
    letter-spacing: 0.02em; transition: all 0.18s ease; white-space: nowrap;
  }
  .btn-create-nav { background: var(--accent-orange); color: #fff; }
  .btn-create-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-search-nav { background: var(--accent-blue); color: #fff; }
  .btn-search-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-accounts-nav { background: var(--accent); color: #fff; }
  .btn-accounts-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-delete-nav { background: oklch(58% 0.2 25); color: #fff; }
  .btn-delete-nav:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-logout-nav { background: #374151; color: #e5e7eb; }
  .btn-logout-nav:hover { background: #4b5563; transform: translateY(-1px); }

  /* ── MAIN ── */
  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    background: radial-gradient(ellipse at 50% 30%, #1a1f2e 0%, #0f1117 65%);
  }

  /* ── CARD ── */
  .form-card {
    width: 100%;
    max-width: 520px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
  }

  /* ── HEADER ── */
  .card-header {
    padding: 20px 26px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, rgba(56,100,180,0.12) 0%, transparent 60%);
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .card-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent));
    border-radius: 18px 18px 0 0;
  }
  .header-icon {
    width: 34px; height: 34px; border-radius: 9px;
    background: var(--accent-blue);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── BODY ── */
  .card-body {
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* player info row */
  .player-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 9px;
  }

  .player-info-label {
    font-size: 11px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .player-info-name {
    font-size: 14px; font-weight: 700;
    color: var(--text);
  }

  .player-pos-badge {
    font-size: 10px; font-weight: 800;
    padding: 2px 8px; border-radius: 5px;
    background: oklch(56% 0.18 210 / 0.15);
    color: oklch(70% 0.16 210);
    border: 1px solid oklch(56% 0.18 210 / 0.3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* field */
  .field { display: flex; flex-direction: column; gap: 6px; }

  .field-label {
    font-size: 10.5px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  textarea {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 400;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 9px;
    padding: 12px 14px;
    width: 100%;
    min-height: 180px;
    resize: vertical;
    outline: none;
    line-height: 1.6;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  textarea:focus {
    border-color: var(--input-focus);
    box-shadow: 0 0 0 3px oklch(56% 0.18 210 / 0.15);
  }
  textarea::placeholder { color: #374151; }

  .char-count {
    font-size: 11px; font-weight: 500;
    color: var(--text-muted);
    text-align: right;
    margin-top: -8px;
  }

  /* ── FOOTER ── */
  .card-footer {
    padding: 16px 26px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    background: var(--surface2);
  }

  .btn-cancel {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 600;
    padding: 10px 22px; border-radius: 9px;
    border: 1px solid var(--border);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease; white-space: nowrap;
  }
  .btn-cancel:hover { background: var(--surface); color: var(--text); border-color: #3a4460; }

  .btn-save {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 700;
    padding: 10px 26px; border-radius: 9px;
    border: none;
    background: var(--accent-blue); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap; letter-spacing: 0.03em;
    display: flex; align-items: center; gap: 7px;
  }
  .btn-save:hover { filter: brightness(1.12); transform: translateY(-1px); box-shadow: 0 4px 14px oklch(56% 0.18 210 / 0.4); }
  .btn-save:active { transform: translateY(0); }

</style>
}

<main>
  <div class="form-card">
    <div class="card-header">
      <div class="header-icon">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <div class="card-title">Edit Comment</div>
    </div>

    <div class="card-body">
      <div class="player-info">
        <span class="player-info-label">Player:</span>
        <span class="player-info-name">@player.Name</span>
        <span class="player-pos-badge">@posDisp</span>
        <span style="margin-left:auto;font-size:11px;color:var(--text-muted);">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
      </div>

      <form asp-controller="Report" asp-action="EditComment" asp-route-playerId="@player.Id" method="post">
        <input type="hidden" name="reportId" value="@Model.Id" />
        <div class="field" style="margin-bottom:16px;">
          <label class="field-label">Latest Report Comment</label>
          <textarea id="comment-area" name="comment" oninput="updateCount()"
                    placeholder="Write your scouting comment here...">@Model.Comments</textarea>
          <div class="char-count" id="char-count">@((Model.Comments ?? "").Length) characters</div>
        </div>
        <div class="card-footer" style="padding:0;background:transparent;border:none;">
          <a class="btn-cancel" asp-controller="Player" asp-action="Details" asp-route-id="@player.Id">Cancel</a>
          <button type="submit" class="btn-save">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
              <polyline points="17 21 17 13 7 13 7 21"/>
              <polyline points="7 3 7 8 15 8"/>
            </svg>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

@section Scripts {
<script>
  function updateCount() {
    const len = document.getElementById('comment-area').value.length;
    document.getElementById('char-count').textContent = len + ' character' + (len !== 1 ? 's' : '');
  }
</script>
}



