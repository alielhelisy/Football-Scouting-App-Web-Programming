@model List<ScoutingAppMvc.Models.PlayerSummaryViewModel>
@{
    ViewData["Title"] = "Search";
    var positions  = (Dictionary<string,string>)ViewBag.Positions;
    var selected   = (List<string>)ViewBag.Selected;
    bool searched  = ViewBag.Searched;
    string nameQ   = ViewBag.NameQuery ?? "";
    string clubQ   = ViewBag.ClubQuery ?? "";
}

@section Styles {
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --nav-bg: #0f1117;
    --nav-border: #1e2230;
    --bg: #0f1117;
    --surface: #161b27;
    --surface2: #1c2232;
    --border: #232a3a;
    --accent: oklch(62% 0.18 145);
    --accent-orange: oklch(72% 0.19 40);
    --accent-blue: oklch(56% 0.18 210);
    --text: #e5e7eb;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --input-bg: #1c2232;
    --input-border: #2a3245;
    --input-focus: oklch(56% 0.18 210);
    --row-hover: rgba(255,255,255,0.03);
  }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  /* ── NAVBAR ── */
  nav {
    background: var(--nav-bg);
    border-bottom: 1px solid var(--nav-border);
    padding: 0 28px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-left { display: flex; align-items: center; gap: 10px; }
  .nav-username { font-weight: 700; font-size: 15px; color: var(--accent-orange); letter-spacing: 0.02em; }
  .nav-badge {
    background: oklch(58% 0.2 25); color: #fff;
    font-size: 10px; font-weight: 700; padding: 3px 8px;
    border-radius: 4px; letter-spacing: 0.08em; text-transform: uppercase;
  }

  .nav-right { display: flex; align-items: center; gap: 6px; }
  .nav-link {
    color: #9ca3af; font-size: 13.5px; font-weight: 500;
    padding: 6px 12px; border-radius: 6px; cursor: pointer;
    transition: color 0.2s, background 0.2s;
    text-decoration: none; background: none; border: none;
  }
  .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-btn {
    font-family: 'Barlow', sans-serif; font-size: 12.5px; font-weight: 600;
    padding: 7px 14px; border-radius: 7px; border: none; cursor: pointer;
    letter-spacing: 0.02em; transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn-create { background: var(--accent-orange); color: #fff; }
  .btn-create:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-search { background: var(--accent-blue); color: #fff; }
  .btn-search:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-accounts { background: var(--accent); color: #fff; }
  .btn-accounts:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-delete { background: oklch(58% 0.2 25); color: #fff; }
  .btn-delete:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .btn-logout { background: #374151; color: #e5e7eb; }
  .btn-logout:hover { background: #4b5563; transform: translateY(-1px); }

  /* ── MAIN ── */
  main {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 24px;
    background: radial-gradient(ellipse at 50% 0%, #1a1f2e 0%, #0f1117 70%);
  }

  /* ── SEARCH CARD ── */
  .search-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    width: 100%;
    max-width: 760px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
  }

  /* ── SEARCH HEADER ── */
  .search-header {
    padding: 20px 28px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, rgba(56,100,180,0.12) 0%, transparent 60%);
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent));
    border-radius: 18px 18px 0 0;
  }

  .search-header-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--accent-blue);
    display: flex; align-items: center; justify-content: center;
    opacity: 0.9;
    flex-shrink: 0;
  }

  .search-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px; font-weight: 800;
    color: var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── SEARCH BODY ── */
  .search-body { padding: 24px 28px; display: flex; flex-direction: column; gap: 16px; }

  /* name + club row */
  .inputs-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 11px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  input[type="text"] {
    font-family: 'Barlow', sans-serif;
    font-size: 14px; font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 8px;
    padding: 10px 14px;
    width: 100%;
    outline: none;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  input[type="text"]:focus {
    border-color: var(--input-focus);
    box-shadow: 0 0 0 3px oklch(56% 0.18 210 / 0.15);
  }
  input[type="text"]::placeholder { color: var(--text-muted); }

  /* positions */
  .positions-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .positions-label {
    font-size: 11px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-right: 4px;
    flex-shrink: 0;
  }

  .pos-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 6px;
    padding: 5px 11px;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .pos-chip:hover { border-color: var(--accent-blue); background: oklch(56% 0.18 210 / 0.08); }

  .pos-chip input[type="checkbox"] { display: none; }

  .pos-chip-check {
    width: 14px; height: 14px;
    border-radius: 4px;
    border: 1.5px solid var(--input-border);
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .pos-chip.checked {
    background: oklch(56% 0.18 210 / 0.15);
    border-color: var(--accent-blue);
  }
  .pos-chip.checked .pos-chip-check {
    background: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .pos-chip-label {
    font-size: 12px; font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.02em;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .pos-chip.checked .pos-chip-label { color: var(--text); }

  /* search button */
  .btn-search-main {
    font-family: 'Barlow', sans-serif;
    font-size: 13.5px; font-weight: 700;
    padding: 10px 24px; border-radius: 8px;
    border: none;
    background: var(--accent-blue); color: #fff;
    cursor: pointer; transition: all 0.18s ease;
    display: flex; align-items: center; gap: 7px;
    align-self: flex-start;
    white-space: nowrap;
  }
  .btn-search-main:hover { filter: brightness(1.12); transform: translateY(-1px); box-shadow: 0 4px 14px oklch(56% 0.18 210 / 0.35); }

  /* ── TABLE ── */
  .table-wrap {
    border-top: 1px solid var(--border);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  thead tr {
    background: var(--surface2);
  }

  th {
    text-align: left;
    padding: 11px 16px;
    font-size: 10.5px; font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  td {
    padding: 11px 16px;
    color: var(--text-dim);
    font-weight: 500;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    white-space: nowrap;
  }

  tbody tr { transition: background 0.15s; }
  tbody tr:hover { background: var(--row-hover); }
  tbody tr:last-child td { border-bottom: none; }

  .table-empty {
    text-align: center;
    padding: 40px 16px;
    color: var(--text-muted);
    font-size: 13px; font-weight: 500;
    font-style: italic;
  }

  /* ── FOOTER ── */
  .search-footer {
    padding: 16px 28px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface2);
  }

  .btn-open-details {
    font-family: 'Barlow', sans-serif;
    font-size: 13px; font-weight: 600;
    padding: 8px 18px; border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface); color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn-open-details:hover { background: var(--surface2); color: var(--text); border-color: #3a4460; }

  .btn-close {
    font-family: 'Barlow', sans-serif;
    font-size: 13px; font-weight: 600;
    padding: 8px 18px; border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.18s ease;
    white-space: nowrap;
  }
  .btn-close:hover { background: oklch(58% 0.2 25 / 0.12); color: oklch(72% 0.2 25); border-color: oklch(58% 0.2 25 / 0.4); }


  .pos-chip-check svg { opacity: 0; transition: opacity 0.15s; }
  .pos-chip.checked .pos-chip-check svg { opacity: 1; }</style>
}

<main>
  <div class="search-card">

    <div class="search-header">
      <div class="search-header-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <div class="search-title">Search Players by Position</div>
    </div>

    <form asp-controller="Search" asp-action="Index" method="get" id="search-form">
      <input type="hidden" name="positions" id="positions-hidden" value="@string.Join(",", selected)" />
      <div class="search-body">

        <div class="inputs-row">
          <div class="field">
            <label class="field-label">Name</label>
            <input type="text" name="name" value="@nameQ" placeholder="Search by name..." />
          </div>
          <div class="field">
            <label class="field-label">Club</label>
            <input type="text" name="club" value="@clubQ" placeholder="Search by club..." />
          </div>
        </div>

        <div class="positions-row">
          <span class="positions-label">Positions:</span>
          @foreach (var pos in positions)
          {
            bool isChecked = selected.Contains(pos.Key);
            <div class="pos-chip @(isChecked ? "checked" : "")" onclick="toggleChip(this, '@pos.Key')">
              <div class="pos-chip-check">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="2,5 4,7 8,3"/>
                </svg>
              </div>
              <span class="pos-chip-label">@pos.Value</span>
            </div>
          }
        </div>

        <button type="submit" class="btn-search-main">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Search
        </button>

      </div>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Name</th><th>Club</th><th>Position</th><th>Rating</th><th>Last Review</th><th>Last By</th>
          </tr>
        </thead>
        <tbody>
          @if (!searched)
          {
            <tr><td colspan="7" class="table-empty">Enter a name, club, or select positions and click Search.</td></tr>
          }
          else if (!Model.Any())
          {
            <tr><td colspan="7" class="table-empty">No players found.</td></tr>
          }
          else
          {
            foreach (var p in Model)
            {
              string rc = p.AvgRating == 0 ? "" : (p.AvgRating <= 1.5m ? "r-high" : p.AvgRating <= 3m ? "r-mid" : "r-low");
              <tr data-id="@p.Id" onclick="selectRow(this, @p.Id)">
                <td style="color:var(--text-muted);font-size:12px;">@p.Id</td>
                <td class="name-cell">@p.Name</td>
                <td></td>
                <td>@p.Position</td>
                <td>
                  @if (p.AvgRating > 0)
                  {
                    <span class="rating-badge @rc">@p.AvgRating.ToString("0.#")</span>
                  }
                </td>
                <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;">
                  @(string.IsNullOrEmpty(p.LastReview) ? "" : (p.LastReview.Length > 50 ? p.LastReview[..50] + "..." : p.LastReview))
                </td>
                <td>@p.ScoutName</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
    <div class="search-footer">
      <a class="btn-open-details disabled" id="btn-open-details" href="#">Open Details</a>
      <a class="btn-close" asp-controller="Player" asp-action="Dashboard">Close</a>
    </div>

  </div>
</main>

@section Scripts {
<script>
  let selectedId  = null;
  const posHidden = document.getElementById('positions-hidden');
  let   selectedPos = new Set(posHidden.value ? posHidden.value.split(',').filter(Boolean) : []);

  function toggleChip(chip, key) {
    chip.classList.toggle('checked');
    if (selectedPos.has(key)) selectedPos.delete(key);
    else selectedPos.add(key);
    posHidden.value = [...selectedPos].join(',');
  }

  function selectRow(row, id) {
    document.querySelectorAll('tbody tr').forEach(r => r.classList.remove('selected'));
    if (selectedId === id) { selectedId = null; setDetailsBtn(null); }
    else {
      row.classList.add('selected');
      selectedId = id;
      setDetailsBtn(id);
    }
  }

  function setDetailsBtn(id) {
    const btn = document.getElementById('btn-open-details');
    if (!btn) return;
    if (id) {
      btn.href = '@Url.Action("Details","Player")/' + id;
      btn.classList.remove('disabled');
    } else {
      btn.href = '#';
      btn.classList.add('disabled');
    }
  }
</script>
}



